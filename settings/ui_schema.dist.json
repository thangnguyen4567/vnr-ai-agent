                "fields": [
                    {
                        "id": "Name",
                        "type": "text",
                        "label": "Tên mục tiêu"
                    },
                    {
                        "id": "Code",
                        "type": "text",
                        "label": "Mã mục tiêu"
                    },
                    {
                        "id": "MeasurementScaleId",
