        "forms": [
            {
                "formKey": "goal-register-basic-form",
                "description": "Form tạo mới mục tiêu",
                "actions": [
                    {
                        "id": "button:save",
                        "description": "Lưu"
                    },
                    {
                        "id": "button:saveTemp",
