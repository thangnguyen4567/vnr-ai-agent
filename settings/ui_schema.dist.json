                    {
                        "id": "Target",
                        "type": "number",
                        "label": "Mục tiêu"
                    },
                    {
                        "id": "Weight",
                        "type": "number",
                        "label": "Trọng số"
                    },
                    {
                        "id": "StartDate",
                        "type": "date",
                        "label": "Ngày bắt đầu"
                    },
                    {
                        "id": "EndDate",
                        "type": "date",
                        "label": "Ngày kết thúc"
                    }
                ]
            }
        ],
        "grids": [],
        "toolbar": [],
        "description": "Màn hình quản lý mục tiêu",
        "buttons": [
            {
                "id": "button:create-goal",
                "description": "Mở form tạo mới mục tiêu"
            },
            {
                "id": "button:create-goal-with-ai",
                "description": "Mở form tạo mới mục tiêu với AI"
            },
            {
                "id": "button:view-department-goal",
                "description": "Mở lưới mục tiêu của phòng ban"
            },
            {
                "id": "button:view-employee-goal",
                "description": "Mở lưới mục tiêu của nhân viên"
            }
        ]
